---
const NAVBAR_ITEMS = [
  { id: "#experiencia", title: "Experiencia" },
  { id: "#proyectos", title: "Proyectos" },
  { id: "#sobremi", title: "Sobre mi" },
];
---

<header class="flex justify-center my-5 w-full hover:cursor-pointer">
  <nav id="navbar" class="fixed z-50">
    <ul class="flex gap-x-4 md:gap-x-8">
      {
        NAVBAR_ITEMS.map((item) => {
          return (
            <li class="transition duration-300 hover:scale-105  hover:text-lightSunglow dark:hover:text-sunglow">
              <a href={item.id}>{item.title}</a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const navbar = document.getElementById("navbar");

  if (navbar) {
    const SCROLLED_CLASSES = [
      "text-white",
      "dark:text-black",
      "dark:bg-white",
      "bg-gray-800",
      "px-4",
      "rounded-full",
    ];

    let ticking = false;

    const updateNavbar = () => {
      if (window.scrollY > 20) {
        navbar.classList.add(...SCROLLED_CLASSES);
      } else {
        navbar.classList.remove(...SCROLLED_CLASSES);
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(updateNavbar);
        }
      },
      { passive: true }
    );

    updateNavbar();
  }
</script>
