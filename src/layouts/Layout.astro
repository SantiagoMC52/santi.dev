---
import "@fontsource-variable/onest";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollToTopButton from "../components/ScrollToTopButton.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Santiago Martínez | Desarrollador Front-End",
  description = "Portfolio de Santiago Martínez, desarrollador Front-End de Girona con más de 2 años de experiencia especializado en el desarrollo de aplicaciones web únicas.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.webp", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Santiago Martínez" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta
      property="og:image:alt"
      content="Portfolio de Santiago Martínez, desarrollador Front-End"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="relative text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-200 dark:bg-gray-800
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(220,220,220,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(100,100,100,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Navbar />
    <slot />
    <ScrollToTopButton />
    <Footer />
  </body>

  <style is:global>
    :root {
      color-scheme: light dark;
    }

    html {
      font-family: "Onest Variable", system-ui, sans-serif;
      scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }

    body {
      display: flex;
      flex-direction: column;
    }
  </style>
</html>
